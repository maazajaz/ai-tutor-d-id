{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "buildCommand": "npm run build"
      }
    },
    {
      "src": "server/server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/generate-quiz",
      "dest": "/api/generate-quiz.js"
    },
    {
      "src": "/api/generate-notes",
      "dest": "/api/generate-notes.js"
    },
    {
      "src": "/api/analyze-diagram",
      "dest": "/api/analyze-diagram.js"
    },
    {
      "src": "/api/execute-code",
      "dest": "/api/execute-code.js"
    },
    {
      "src": "/api/explain-solution",
      "dest": "/api/explain-solution.js"
    },
    {
      "src": "/api/generate-drawing",
      "dest": "/api/generate-drawing.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
